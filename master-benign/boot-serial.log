[0;90m
[0;38:5:245m      Content: "[Unit]\nDescription=cOS setup reconciler\n\n[Timer]\nOnBootSec=5min\nOnUnitActiveSec=60min\nUnit=cos-setup-reconcile.service\n\n[Install]\nWantedBy=multi-user.target\n",
                                                         
