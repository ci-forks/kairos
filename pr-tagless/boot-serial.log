[0;90m
[0;38:5:245m      Permissions: 420,
                                                     
[0;90m
[0;38:5:245m      Content: "[Service]\n# Make it timeout early to avoid blocking boot if keys are not in there to unlock sysext\nTimeoutStartSec=10\n# override exec and reload to set the image policy\nExecStart=\nExecStart=systemd-confext refresh --image-policy=\"root=verity+absent:usr=verity+absent\"\nExecReload=\nExecReload=systemd-confext refresh --image-policy=\"root=verity+absent:usr=verity+absent\"\n[Unit]\n# Make it timeout early to avoid blocking boot if keys are not in there to unlock sysext\nJobRunningTimeoutSec=5\n",
                                                     
[0;90m
